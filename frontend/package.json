{
  "name": "vibeos-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.7",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.74.0",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  }
}
